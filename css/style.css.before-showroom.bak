css
:root {
  --burgundy: #701f3a;
  --plum: #35172e;
  --gold: #c49a45;
  --gold-light: #f0dfb2;
  --ivory: #fffaf1;
  --white: #ffffff;
  --text: #33272d;
  --muted: #766970;
  --border: #eadfdc;
  --shadow: 0 8px 28px rgba(53, 23, 46, 0.09);
  --radius: 16px;
}

* {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
  scroll-padding-top: 90px;
}

body {
  margin: 0;
  background: var(--ivory);
  color: var(--text);
  font-family: Arial, Helvetica, sans-serif;
  line-height: 1.6;
}

img {
  display: block;
  max-width: 100%;
}

a {
  color: inherit;
  text-decoration: none;
}

button,
input,
textarea,
select {
  font: inherit;
}

button,
a {
  -webkit-tap-highlight-color: transparent;
}

button {
  cursor: pointer;
}

.container {
  width: min(1120px, calc(100% - 36px));
  margin-inline: auto;
}

.site-header {
  position: sticky;
  top: 0;
  z-index: 100;
  background: rgba(255, 250, 241, 0.97);
  border-bottom: 1px solid var(--border);
  backdrop-filter: blur(12px);
}

.header-inner {
  min-height: 76px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18px;
}

.brand {
  display: inline-flex;
  align-items: center;
  gap: 12px;
  min-width: 0;
}

.brand-logo {
  width: 54px;
  height: 54px;
  object-fit: contain;
  border-radius: 50%;
  background: var(--white);
}

.brand-copy {
  min-width: 0;
}

.brand-name {
  display: block;
  color: var(--plum);
  font-family: Georgia, "Times New Roman", serif;
  font-size: 17px;
  font-weight: 700;
  line-height: 1.2;
}

.brand-tagline {
  display: block;
  color: var(--muted);
  font-size: 11px;
  letter-spacing: 1.1px;
  text-transform: uppercase;
}

.desktop-nav {
  display: flex;
  align-items: center;
  gap: 24px;
}

.desktop-nav a {
  color: var(--plum);
  font-size: 14px;
  font-weight: 700;
}

.desktop-nav a:hover,
.desktop-nav a[aria-current="page"] {
  color: var(--burgundy);
}

.button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  min-height: 46px;
  padding: 11px 20px;
  border: 1px solid var(--burgundy);
  border-radius: 999px;
  background: var(--burgundy);
  color: var(--white);
  font-weight: 700;
  text-align: center;
  transition: transform 0.2s, background 0.2s;
}

.button:hover {
  transform: translateY(-2px);
  background: var(--plum);
}

.button-outline {
  background: transparent;
  color: var(--burgundy);
}

.button-outline:hover {
  color: var(--white);
}

.button-gold {
  border-color: var(--gold);
  background: var(--gold);
  color: var(--plum);
}

.button-gold:hover {
  background: var(--gold-light);
  color: var(--plum);
}

.hero {
  overflow: hidden;
  padding: 64px 0;
  background:
    radial-gradient(ellipse at 90% 10%, rgba(196, 154, 69, 0.18), transparent 40%),
    linear-gradient(135deg, #fffaf1, #f4e8e9);
}

.hero-grid {
  display: grid;
  grid-template-columns: 1.1fr 0.9fr;
  align-items: center;
  gap: 48px;
}

.eyebrow {
  margin: 0 0 12px;
  color: var(--burgundy);
  font-size: 12px;
  font-weight: 800;
  letter-spacing: 2px;
  text-transform: uppercase;
}

h1,
h2,
h3 {
  margin-top: 0;
  color: var(--plum);
  font-family: Georgia, "Times New Roman", serif;
  line-height: 1.2;
}

h1 {
  margin-bottom: 20px;
  font-size: clamp(36px, 5vw, 58px);
}

h2 {
  margin-bottom: 14px;
  font-size: clamp(27px, 3.5vw, 38px);
}

h3 {
  margin-bottom: 8px;
  font-size: 21px;
}

.hero-description,
.section-description {
  max-width: 620px;
  color: var(--muted);
  font-size: 16px;
}

.hero-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
  margin-top: 26px;
}

.hero-art {
  display: grid;
  min-height: 350px;
  place-items: center;
  padding: 26px;
  border: 1px solid rgba(196, 154, 69, 0.4);
  border-radius: 48% 48% 22px 22px;
  background: linear-gradient(145deg, #f5e6d5, #ead5dd);
}

.hero-art img {
  width: min(100%, 300px);
  max-height: 300px;
  object-fit: contain;
  border-radius: 50%;
}

.section {
  padding: 64px 0;
}

.section-soft {
  background: #f7efeb;
}

.section-heading {
  margin-bottom: 28px;
}

.section-heading.center {
  text-align: center;
}

.section-heading.center .section-description {
  margin-inline: auto;
}

.category-grid,
.product-grid,
.feature-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 18px;
}

.category-card {
  display: flex;
  min-height: 180px;
  flex-direction: column;
  justify-content: flex-end;
  padding: 22px;
  border: 1px solid var(--border);
  border-radius: var(--radius);
  background: linear-gradient(145deg, var(--white), #f3e2e5);
  box-shadow: var(--shadow);
  transition: transform 0.2s, border-color 0.2s;
}

.category-card:hover {
  transform: translateY(-4px);
  border-color: var(--gold);
}

.category-symbol {
  margin-bottom: auto;
  color: var(--gold);
  font-size: 34px;
}

.category-card h3 {
  margin: 18px 0 4px;
}

.category-card p {
  margin: 0;
  color: var(--muted);
  font-size: 13px;
}

.product-toolbar {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: 14px;
  margin: 22px 0;
}

.search-field {
  width: min(100%, 360px);
  min-height: 46px;
  padding: 11px 15px;
  border: 1px solid var(--border);
  border-radius: 999px;
  outline: none;
  background: var(--white);
}

.search-field:focus,
.form-control:focus {
  border-color: var(--gold);
  box-shadow: 0 0 0 3px rgba(196, 154, 69, 0.15);
}

.filter-list {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin: 18px 0 26px;
}

.filter-button {
  padding: 8px 14px;
  border: 1px solid var(--border);
  border-radius: 999px;
  background: var(--white);
  color: var(--plum);
  font-size: 13px;
  font-weight: 700;
}

.filter-button.active,
.filter-button:hover {
  border-color: var(--burgundy);
  background: var(--burgundy);
  color: var(--white);
}

.product-card {
  overflow: hidden;
  border: 1px solid var(--border);
  border-radius: var(--radius);
  background: var(--white);
  box-shadow: var(--shadow);
}

.product-image {
  display: grid;
  aspect-ratio: 4 / 3;
  place-items: center;
  overflow: hidden;
  background: linear-gradient(145deg, #f4e6e8, #f7eddc);
  color: var(--burgundy);
  font-size: 44px;
}

.product-image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.product-info {
  padding: 16px;
}

.product-info h3 {
  font-family: Arial, Helvetica, sans-serif;
  font-size: 16px;
}

.product-info p {
  margin: 7px 0 14px;
  color: var(--muted);
  font-size: 13px;
}

.product-label {
  display: inline-block;
  margin-bottom: 8px;
  padding: 4px 9px;
  border-radius: 999px;
  background: #f7efdc;
  color: #76551c;
  font-size: 11px;
  font-weight: 700;
}

.product-info .button {
  width: 100%;
  min-height: 40px;
  padding: 8px 12px;
  font-size: 13px;
}

.empty-state {
  grid-column: 1 / -1;
  padding: 30px 20px;
  border: 1px dashed var(--gold);
  border-radius: var(--radius);
  color: var(--muted);
  text-align: center;
}

.notice {
  padding: 14px 16px;
  border-left: 4px solid var(--gold);
  border-radius: 8px;
  background: #fbf1dc;
  color: #5b4828;
  font-size: 13px;
}

.feature-card {
  padding: 22px;
  border: 1px solid var(--border);
  border-radius: var(--radius);
  background: var(--white);
}

.feature-card p {
  margin-bottom: 0;
  color: var(--muted);
  font-size: 14px;
}

.contact-layout {
  display: grid;
  grid-template-columns: 0.9fr 1.1fr;
  gap: 28px;
  align-items: start;
}

.contact-panel,
.contact-form {
  padding: 26px;
  border: 1px solid var(--border);
  border-radius: var(--radius);
  background: var(--white);
  box-shadow: var(--shadow);
}

.contact-detail {
  margin: 18px 0;
}

.contact-detail strong {
  display: block;
  color: var(--plum);
}

.contact-detail span {
  color: var(--muted);
  overflow-wrap: anywhere;
}

.form-group {
  margin-bottom: 17px;
}

.form-group label {
  display: block;
  margin-bottom: 6px;
  color: var(--plum);
  font-size: 14px;
  font-weight: 700;
}

.form-control {
  width: 100%;
  min-height: 46px;
  padding: 11px 13px;
  border: 1px solid var(--border);
  border-radius: 10px;
  outline: none;
  background: var(--ivory);
}

textarea.form-control {
  min-height: 130px;
  resize: vertical;
}

.site-footer {
  padding: 34px 0 90px;
  background: var(--plum);
  color: #f9edf2;
}

.footer-inner {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  gap: 18px;
}

.site-footer p {
  margin: 5px 0;
  color: #e4d3dc;
  font-size: 13px;
}

.footer-links {
  display: flex;
  flex-wrap: wrap;
  gap: 16px;
  font-size: 13px;
}

.footer-credit {
  width: 100%;
  margin-top: 18px;
  padding-top: 15px;
  border-top: 1px solid rgba(255, 255, 255, 0.15);
  text-align: center;
}

.footer-credit a {
  color: var(--gold-light);
}

.mobile-bottom-nav {
  display: none;
}

@media (max-width: 900px) {
  .desktop-nav {
    gap: 14px;
  }

  .header-contact {
    display: none;
  }

  .hero-grid {
    gap: 26px;
  }

  .category-grid,
  .product-grid,
  .feature-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

@media (max-width: 640px) {
  html {
    scroll-padding-top: 75px;
  }

  .container {
    width: min(100% - 28px, 520px);
  }

  .header-inner {
    min-height: 68px;
  }

  .brand-logo {
    width: 45px;
    height: 45px;
  }

  .brand-name {
    font-size: 14px;
  }

  .brand-tagline {
    font-size: 9px;
    letter-spacing: 0.7px;
  }

  .desktop-nav {
    display: none;
  }

  .hero {
    padding: 42px 0;
  }

  .hero-grid {
    grid-template-columns: 1fr;
    gap: 28px;
  }

  h1 {
    font-size: 39px;
  }

  .hero-art {
    min-height: 240px;
    padding: 20px;
    border-radius: 30px;
  }

  .hero-art img {
    max-height: 210px;
  }

  .section {
    padding: 44px 0;
  }

  .category-grid,
  .product-grid,
  .feature-grid {
    gap: 12px;
  }

  .category-card {
    min-height: 150px;
    padding: 15px;
  }

  .category-card h3 {
    font-size: 17px;
  }

  .product-info {
    padding: 12px;
  }

  .product-info h3 {
    font-size: 14px;
  }

  .product-info .button {
    font-size: 12px;
  }

  .product-toolbar {
    align-items: stretch;
  }

  .search-field {
    width: 100%;
  }

  .contact-layout {
    grid-template-columns: 1fr;
  }

  .contact-panel,
  .contact-form {
    padding: 20px;
  }

  .mobile-bottom-nav {
    position: fixed;
    right: 0;
    bottom: 0;
    left: 0;
    z-index: 200;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    padding: 8px 5px calc(8px + env(safe-area-inset-bottom));
    border-top: 1px solid var(--border);
    background: rgba(255, 250, 241, 0.98);
    box-shadow: 0 -6px 22px rgba(53, 23, 46, 0.08);
  }

  .mobile-bottom-nav a {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
    padding: 4px 2px;
    color: var(--plum);
    font-size: 11px;
    font-weight: 700;
  }

  .mobile-bottom-nav a[aria-current="page"] {
    color: var(--burgundy);
  }

  .mobile-nav-icon {
    font-size: 19px;
    line-height: 1.2;
  }

  .site-footer {
    padding-bottom: 100px;
  }
}

@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    scroll-behavior: auto !important;
    transition-duration: 0.01ms !important;
    animation-duration: 0.01ms !important;
  }
}


/* UTSAV SHRANGAR & GARMENTS
   Professional Ivory, Teal & Champagne Gold Theme */

:root {
  --utsav-wine: #174F4A;
  --utsav-gold: #D2B477;
  --utsav-ivory: #F8F6F0;

  --primary-color: #174F4A;
  --accent-color: #D2B477;
  --background-color: #F8F6F0;
  --text-color: #292D2C;
}

/* Main website background */
body {
  background: #F8F6F0 !important;
  color: #292D2C;
}

/* Header and navigation */
header,
.site-header,
.navbar {
  background: #FFFFFF;
  border-bottom: 1px solid #E8E1D3;
}

/* Main headings */
h1, h2, h3 {
  color: #174F4A;
}

/* Buttons and highlighted links */
button,
.btn,
.button,
.primary-button {
  background-color: #174F4A;
  color: #FFFFFF;
  border-color: #174F4A;
}

button:hover,
.btn:hover,
.button:hover,
.primary-button:hover {
  background-color: #103D39;
  border-color: #103D39;
}

/* Gold accents */
.product-card,
.category-card,
.service-card {
  border-color: #E5D7B8;
}

.product-card:hover,
.category-card:hover,
.service-card:hover {
  border-color: #D2B477;
}

/* Product cards */
.product-card,
.category-card,
.service-card {
  background: #FFFFFF;
  border-radius: 14px;
  box-shadow: 0 5px 18px rgba(35, 54, 49, 0.07);
}

/* Category filters */
.filter-button,
[data-category-filters] button {
  background: #FFFFFF;
  color: #174F4A;
  border: 1px solid #D9D5C9;
}

.filter-button.active,
.filter-button[aria-pressed="true"],
[data-category-filters] button.active {
  background: #174F4A;
  color: #FFFFFF;
  border-color: #174F4A;
}

/* Search and form fields */
input,
select,
textarea {
  background: #FFFFFF;
  color: #292D2C;
  border: 1px solid #D8D4C9;
  border-radius: 8px;
}

input:focus,
select:focus,
textarea:focus {
  outline: 2px solid #D2B477;
  outline-offset: 1px;
}

/* Footer */
footer,
.site-footer {
  background: #174F4A;
  color: #FFFFFF;
}

footer h2,
footer h3,
.site-footer h2,
.site-footer h3 {
  color: #FFFFFF;
}

footer a,
.site-footer a {
  color: #EAD6A5;
}

/* Gold decorative separators */
hr {
  border: 0;
  border-top: 1px solid #D2B477;
}

/* UTSAV: clean, image-only product gallery */
.product-card {
  border: none !important;
  box-shadow: none !important;
  background: transparent !important;
  overflow: hidden;
}

.product-card .product-info {
  display: none !important;
}

.product-card .product-image {
  aspect-ratio: 3 / 4;
  overflow: hidden;
  border-radius: 12px;
  background: #f7f2e9;
}

.product-card .product-image img {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.35s ease;
}

.product-card:hover .product-image img {
  transform: scale(1.04);
}

/* Keep the image gallery responsive */
@media (max-width: 600px) {
  .product-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
  }
}

